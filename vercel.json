{
  // vercel.json — Vercel deploy config (jsonc comments are supported)

  "version": 2,

  // Build the React app. Server is bundled as a serverless function, no build step needed.
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",

  // First match wins.
  "rewrites": [
    // API routes → Express serverless function
    { "source": "/api/(.*)", "destination": "/api/$1" },

    // Non-API paths → React app (enables client-side routing)
    // (?!api) prevents this rule from catching API routes
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
