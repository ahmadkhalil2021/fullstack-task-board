# Client-side env vars (read by Vite at build time).
# Only variables prefixed with VITE_ are exposed to the client.
# Copy this file to .env or .env.local and fill in values.
#
# In production on Vercel, set this in the dashboard OR leave unset
# to fall back to '/api' (same-origin via Vercel rewrites in vercel.json).

VITE_API_URL=http://localhost:3000
